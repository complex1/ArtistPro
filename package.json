{
  "name": "artist-studio",
  "private": true,
  "version": "0.1.0",
  "productName": "Artist Studio",
  "author": "Artist Studio",
  "description": "A local creative suite for drawing, SVG animation, procedural brushes, 2D character rigging, 3D reference, and phone shortcuts.",
  "type": "module",
  "main": "apps/desktop/electron/main.mjs",
  "workspaces": [
    "apps/desktop",
    "apps/svg-tool",
    "apps/animated-paint",
    "apps/drawing-canvas",
    "apps/frame-by-frame",
    "apps/cel",
    "apps/live-character",
    "apps/tappilot",
    "common/ui-component",
    "common/utils",
    "common/packages/*",
    "apps/reference-3d",
    "apps/anime-3d"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "concurrently -k -n web,phone,desktop -c cyan,yellow,magenta \"npm run dev:web\" \"npm run dev:tappilot-phone\" \"npm run dev:electron\"",
    "dev:web": "vite",
    "dev:tappilot-phone": "vite --config apps/tappilot/vite.phone.config.ts",
    "dev:api": "node scripts/api.mjs serve",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "tsc -b && vite build && vite build --config apps/tappilot/vite.phone.config.ts",
    "lint": "oxlint",
    "test": "vitest run && npm run test:tappilot && npm run test:api",
    "test:drawing-canvas:browser": "electron apps/drawing-canvas/test/browser-smoke.mjs",
    "test:tappilot": "npm test --workspace=@artist-studio/tappilot",
    "test:api": "node scripts/api.mjs test",
    "setup:api": "node scripts/api.mjs setup",
    "preview": "vite preview",
    "package": "npm run build && npm run build:backend && electron-builder --dir --publish never",
    "dist": "npm run build && npm run build:backend && electron-builder --publish never",
    "test:frame-by-frame:browser": "electron apps/frame-by-frame/test/browser-smoke.mjs",
    "test:reference-3d:browser": "electron apps/reference-3d/test/browser-smoke.mjs",
    "test:anime-3d:browser": "electron apps/anime-3d/test/browser-smoke.mjs",
    "setup": "npm ci && npm run setup:api",
    "build:backend": "node scripts/build-backend.mjs",
    "test:browser": "node scripts/browser-tests.mjs",
    "test:suite:browser": "electron scripts/suite-browser.mjs",
    "docs:screenshots": "electron scripts/suite-browser.mjs --screenshots",
    "build:site": "node scripts/build-site.mjs",
    "preview:site": "node scripts/serve-site.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm test && npm run build && npm run build:site && npm run check:docs",
    "test:backend-runtime": "node scripts/test-backend-runtime.mjs",
    "release:checksums": "node scripts/release-checksums.mjs",
    "licenses:collect": "node scripts/collect-licenses.mjs",
    "test:packaged": "node scripts/test-packaged.mjs"
  },
  "dependencies": {
    "@buzz-dee/vtrace": "^1.2.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@fontsource/inter": "^5.3.0",
    "@svgdotjs/svg.js": "^3.2.8",
    "codemirror": "^6.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "imagetracerjs": "^1.2.6",
    "immer": "^11.1.18",
    "jsep": "^1.4.0",
    "lucide-react": "^1.33.0",
    "mediabunny": "^1.55.2",
    "nanoid": "^6.0.1",
    "perfect-freehand": "^1.2.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "ws": "^8.18.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@xmldom/xmldom": "^0.9.12",
    "concurrently": "^9.2.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.3"
  },
  "license": "MIT",
  "homepage": "https://complex1.github.io/ArtistPro/",
  "repository": {
    "type": "git",
    "url": "https://github.com/complex1/ArtistPro.git"
  },
  "bugs": {
    "url": "https://github.com/complex1/ArtistPro/issues"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "keywords": [
    "drawing",
    "animation",
    "svg-editor",
    "vector-animation",
    "digital-art",
    "procedural-brushes",
    "frame-by-frame-animation",
    "2d-character-rigging",
    "3d-reference",
    "electron",
    "macos",
    "windows",
    "linux"
  ],
  "overrides": {
    "brace-expansion@^5.0.0": "^5.0.12"
  }
}
